<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Actions to link buttons on repair.order -->
    <record id="action_start_timer_wrapper" model="ir.actions.server">
        <field name="name">Start Timer Wrapper</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_start_timer(context.get('name'))
        </field>
    </record>

    <record id="action_pause_timer_wrapper" model="ir.actions.server">
        <field name="name">Pause Timer Wrapper</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_pause_timer(context.get('name'))
        </field>
    </record>

    <record id="action_resume_timer_wrapper" model="ir.actions.server">
        <field name="name">Resume Timer Wrapper</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_resume_timer(context.get('name'))
        </field>
    </record>
</odoo>
