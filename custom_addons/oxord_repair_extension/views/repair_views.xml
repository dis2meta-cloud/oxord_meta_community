<odoo>
    <record id="view_repair_order_form_inherit_oxord" model="ir.ui.view">
        <field name="name">repair.order.form.oxord.extension</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            
            <!-- Insert Oxord Workflow after Repair Reference -->
            <xpath expr="//field[@name='name']/.." position="after">
                <group string="Oxord Workflow">
                    <group>
                        <field name="initial_check_by"/>
                        <field name="initial_check_aging" readonly="1"/>
                        <button name="action_start_timer" type="object" string="Start Initial Check" class="btn-sm" context="{'name':'initial_check'}"/>
                    </group>
                    <group>
                        <field name="received_date"/>
                        <field name="received_aging" readonly="1"/>
                        <button name="action_start_timer" type="object" string="Start Received" class="btn-sm" context="{'name':'received'}"/>
                    </group>
                    <group>
                        <field name="encoded_by"/>
                        <field name="work_order"/>
                    </group>
                    <group>
                        <field name="endorse_to_tech_date"/>
                        <field name="endorse_to_tech_aging" readonly="1"/>
                        <button name="action_start_timer" type="object" string="Start Endorse-&gt;Tech" class="btn-sm" context="{'name':'endorse_to_tech'}"/>
                    </group>
                    <group>
                        <field name="customer_approval_date"/>
                        <field name="customer_approval_aging" readonly="1"/>
                        <button name="action_pause_timer" type="object" string="Pause Cust Approval" class="btn-sm" context="{'name':'customer_approval'}"/>
                        <button name="action_resume_timer" type="object" string="Resume Cust Approval" class="btn-sm" context="{'name':'customer_approval'}"/>
                    </group>
                    <group>
                        <field name="parts_request_date"/>
                        <field name="parts_request_aging" readonly="1"/>
                        <button name="action_start_timer" type="object" string="Start Parts Request" class="btn-sm" context="{'name':'parts_request'}"/>
                        <button name="action_pause_timer" type="object" string="Pause Parts" class="btn-sm" context="{'name':'parts_request'}"/>
                        <button name="action_resume_timer" type="object" string="Resume Parts" class="btn-sm" context="{'name':'parts_request'}"/>
                    </group>
                    <group>
                        <field name="end_repair_date"/>
                        <field name="end_repair_aging" readonly="1"/>
                        <field name="bin_location"/>
                    </group>
                    <group>
                        <field name="technician_note"/>
                        <field name="coordinator_note"/>
                    </group>
                    <group>
                        <field name="released_by_occ"/>
                        <field name="released_date"/>
                    </group>
                </group>
            </xpath>

            <!-- Keep only Customer Product to Repair and Under Warranty -->
            <xpath expr="//group[has_field('customer_product_to_repair')]" position="attributes">
                <attribute name="string">Customer Product Info</attribute>
            </xpath>

        </field>
    </record>
</odoo>
