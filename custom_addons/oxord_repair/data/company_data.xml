<odoo>
    <!-- Main Company -->
    <record id="company_oxord" model="res.company">
        <field name="name">OXORD</field>
    </record>

    <!-- Branch Company: La Hacienda -->
    <record id="company_oxord_lahacienda" model="res.company">
        <field name="name">OXORD La Hacienda</field>
        <field name="parent_id" ref="oxord_repair.company_oxord"/>
    </record>

    <!-- Branch Company: Robinsons -->
    <record id="company_oxord_robinsons" model="res.company">
        <field name="name">OXORD Robinsons</field>
        <field name="parent_id" ref="oxord_repair.company_oxord"/>
    </record>
</odoo>
