<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_repair_order_form_oxord" model="ir.ui.view">
      <field name="name">repair.order.form.oxord</field>
      <field name="model">repair.order</field>
      <field name="inherit_id" ref="repair.view_repair_order_form"/>
      <field name="arch" type="xml">

        <!-- ✅ Add Parts Request button in top header beside state buttons -->
        <xpath expr="//header" position="inside">
          <button name="action_open_parts_request"
                  type="object"
                  string="Parts Request"
                  class="btn btn-primary"
                  modifiers="{'invisible': [('state', 'not in', ['confirmed', 'under_repair'])]}"/>
        </xpath>

        <!-- 🛠️ Top Section -->
        <xpath expr="//form/sheet/group" position="replace">
          <group col="2">
            <separator string="OXORD REPAIR ORDER" colspan="2"/>
            <field name="picking_product_ids" invisible="1"/>
            <field name="picking_product_id" invisible="1"/>
            <field name="reserve_visible" invisible="1"/>
            <field name="unreserve_visible" invisible="1"/>
            <field name="schedule_date" invisible="1"/>
            <field name="company_id" options="{'no_create': False}"/>
            <field name="component_status"/>
            <field name="partner_id" string="Customer"/>
            <field name="product_id" string="Product to Repair"/>
          </group>
        </xpath>

        <!-- 📅 Process Timeline Section -->
        <xpath expr="//form/sheet/notebook" position="before">
          <group string="Process Timeline" col="2">
            <group string="Received" col="2">
              <field name="received_date"/>
              <field name="received_aging"/>
            </group>
            <group string="Initial Check" col="2">
              <field name="initial_check_by"/>
              <field name="initial_check_aging"/>
            </group>
            <group string="Encoded" col="2">
              <field name="encoded_by"/>
              <field name="encoded_aging"/>
            </group>
            <group string="To Technician" col="2">
              <field name="endorse_to_tech"/>
              <field name="endorse_to_tech_aging"/>
            </group>
            <group string="To Coordinator" col="2">
              <field name="endorse_to_authorized_coordinator"/>
              <field name="endorse_to_authorized_coordinator_aging"/>
            </group>
          </group>
        </xpath>

        <!-- ❌ Remove Tabs -->
        <xpath expr="//page[@name='parts']" position="replace"/>
        <xpath expr="//page[@name='repair_notes']" position="replace"/>
        <xpath expr="//page[@name='page_miscellaneous']" position="replace"/>

      </field>
    </record>

  </data>
</odoo>
